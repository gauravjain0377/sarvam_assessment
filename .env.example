# Get a free key from https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_your_key_here

# Which currently available free chat model to use
SARVAM_MODEL=sarvam-105b

# Port the server listens on
PORT=3000

# Max requests/min Setu will allow itself to send to Sarvam.
# Sarvam's Starter plan caps sarvam-105b specifically at 40 req/min
# (their smaller default chat models get 60 req/min, these larger ones don't —
# check docs.sarvam.ai/api/ratelimits before changing this). Keep some
# headroom below the real cap so a burst of concurrent chats queues instead
# of tripping a 429.
SARVAM_RATE_LIMIT_PER_MIN=35
